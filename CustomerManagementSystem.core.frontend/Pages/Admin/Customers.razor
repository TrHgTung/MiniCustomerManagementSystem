@page "/admin/customers"
@attribute [Authorize]
@inject IAuthService AuthService
@inject NavigationManager Navigation

<PageTitle>Quản lý khách hàng</PageTitle>

<div class="container-fluid py-3">
    <div class="d-flex justify-content-between align-items-center mb-3 pb-2 border-bottom">
        <div>
            <h4 class="mb-0 text-primary">Danh Sách Khách Hàng</h4>
            <small class="text-muted">
                Xin chào, <strong>@(currentUser?.OrgName ?? "Quản trị viên")</strong> 
                (@(currentUser?.Role == "2" ? "Super Admin" : "Manager"))
            </small>
        </div>
        <div>
            <button class="btn btn-outline-danger btn-sm" @onclick="HandleLogout">
                Đăng xuất
            </button>
        </div>
    </div>

    <div class="alert alert-info py-2" role="alert">
        Đăng nhập thành công vào admin page
    </div>
</div>

@code {
    private OrgMemberDto? currentUser;

    protected override async Task OnInitializedAsync()
    {
        currentUser = await AuthService.GetCurrentUserInfoAsync();
    }

    private async Task HandleLogout()
    {
        await AuthService.LogoutAsync();
        Navigation.NavigateTo("admin/login");
    }
}
